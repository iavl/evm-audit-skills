{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:feature-map:v2",
  "title": "EVM audit reconnaissance feature map",
  "type": "object",
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": {"const": 2},
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["PRESENT", "ABSENT_CONFIRMED", "UNKNOWN"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "location", "reason"],
              "properties": {
                "kind": {"enum": ["slither-ast", "slither-ir", "compiler-ast", "source", "deployment", "manual", "legacy"]},
                "location": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "reason": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["PRESENT", "ABSENT_CONFIRMED"]}}},
            "then": {"required": ["evidence"], "properties": {"evidence": {"minItems": 1}}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
