{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:audit-state:v2",
  "type": "object",
  "additionalProperties": false,
    "required": ["schema_version", "routing_snapshot_id", "review_snapshot_id", "review_state_digest", "registry_sha256", "source_digest", "compilation_input_digest", "status", "complete", "clean", "reasons", "recon_quality", "coverage"],
  "properties": {
    "schema_version": {"const": 2},
    "routing_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_snapshot_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "review_state_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compilation_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["INVALID_SNAPSHOT", "INCOMPLETE_COVERAGE", "INCOMPLETE_DOMAIN_ROUTING", "INCOMPLETE_CONTEXT", "INCOMPLETE_REVIEW", "COMPLETE_CLEAN", "COMPLETE_WITH_FINDINGS"]},
    "complete": {"type": "boolean"},
    "clean": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "recon_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilation_complete", "absence_filtering_complete", "mode", "uncompiled_paths"],
      "properties": {
        "compilation_complete": {"type": "boolean"},
        "absence_filtering_complete": {"type": "boolean"},
        "mode": {"enum": ["COMPLETE", "CONSERVATIVE_DEGRADED"]},
        "uncompiled_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "screen_not_applicable", "deep_candidates", "deep_reviewed", "suspicious", "confirmed", "unresolved"],
      "properties": {
        "selected": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "screen_not_applicable": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "deep_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "deep_reviewed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "suspicious": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "confirmed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unresolved": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["INVALID_SNAPSHOT", "INCOMPLETE_COVERAGE", "INCOMPLETE_DOMAIN_ROUTING", "INCOMPLETE_CONTEXT", "INCOMPLETE_REVIEW"]}}, "required": ["status"]},
      "then": {"properties": {"complete": {"const": false}, "clean": {"const": false}}}
    },
    {
      "if": {"properties": {"status": {"const": "COMPLETE_CLEAN"}}, "required": ["status"]},
      "then": {"properties": {"complete": {"const": true}, "clean": {"const": true}, "review_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "review_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    },
    {
      "if": {"properties": {"status": {"const": "COMPLETE_WITH_FINDINGS"}}, "required": ["status"]},
      "then": {"properties": {"complete": {"const": true}, "clean": {"const": false}, "review_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "review_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    }
  ]
}
