{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:feature-map:v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recon_context", "features"],
  "properties": {
    "schema_version": {"const": 4},
    "recon_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_root", "build_root", "files_analyzed", "excluded_paths", "exclusion_patterns", "include_patterns", "dependency_roots", "uncompiled_paths", "source_digest", "audit_source_digest", "dependency_digest", "build_config_digest", "compilation_input_digest", "compilation_complete", "recon_quality", "slither_version", "solc_version"],
      "properties": {
        "target_root": {"type": "string", "minLength": 1},
        "build_root": {"type": "string", "minLength": 1},
        "files_analyzed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excluded_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusion_patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "include_patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dependency_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "compilation_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "uncompiled_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_digest": {"$ref": "#/$defs/hash"},
        "audit_source_digest": {"$ref": "#/$defs/hash"},
        "dependency_digest": {"$ref": "#/$defs/hash"},
        "build_config_digest": {"$ref": "#/$defs/hash"},
        "compilation_input_digest": {"$ref": "#/$defs/hash"},
        "compilation_complete": {"type": "boolean"},
        "recon_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compilation_complete", "absence_filtering_complete", "mode", "uncompiled_paths"],
          "properties": {
            "compilation_complete": {"type": "boolean"},
            "absence_filtering_complete": {"type": "boolean"},
            "mode": {"enum": ["COMPLETE", "CONSERVATIVE_DEGRADED"]},
            "uncompiled_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "slither_version": {"type": "string", "minLength": 1},
        "solc_version": {"type": ["string", "null"]},
        "compiler_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {"enum": ["PRESENT", "ABSENT_CONFIRMED", "UNKNOWN"]},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "reason"],
      "properties": {
        "kind": {"enum": ["slither-ast", "slither-ir", "compiler-ast", "source", "deployment", "manual"]},
        "location": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "scope_origin": {"enum": ["AUDIT_SCOPE", "DEPENDENCY", "FIRST_PARTY_DEPENDENCY", "EXTERNAL_DEPENDENCY", "UNKNOWN"]}
      }
    }
  }
}
