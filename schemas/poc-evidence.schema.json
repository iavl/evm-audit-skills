{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:poc-evidence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "schema_version", "artifact_state", "routing_snapshot_id", "review_snapshot_id",
    "review_state_digest", "registry_sha256", "source_digest", "compilation_input_digest",
    "severity_decisions_sha256", "findings"
  ],
  "properties": {
    "artifact_type": {"const": "poc-evidence"},
    "schema_version": {"const": 1},
    "artifact_state": {"enum": ["TEMPLATE", "COMPLETED"]},
    "routing_snapshot_id": {"$ref": "#/$defs/hash"},
    "review_snapshot_id": {"$ref": "#/$defs/hash"},
    "review_state_digest": {"$ref": "#/$defs/hash"},
    "registry_sha256": {"$ref": "#/$defs/hash"},
    "source_digest": {"$ref": "#/$defs/hash"},
    "compilation_input_digest": {"$ref": "#/$defs/hash"},
    "severity_decisions_sha256": {"$ref": "#/$defs/hash"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"artifact_state": {"const": "COMPLETED"}}},
      "then": {
        "properties": {
          "findings": {
            "items": {"required": ["runner", "command", "sources", "entrypoint", "expected_result", "result_summary"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "severity"],
      "properties": {
        "canonical_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["High", "Critical"]},
        "runner": {"enum": ["foundry", "hardhat", "custom"]},
        "command": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/hash"}
            }
          }
        },
        "entrypoint": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "result_summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
