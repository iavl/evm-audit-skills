{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:feature-detectors:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": {"const": 1},
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "label", "absence_capable"],
        "properties": {
          "mode": {"enum": ["heuristic", "structural"]},
          "implementation": {"type": "string", "minLength": 1},
          "terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "label": {"type": "string", "minLength": 1},
          "absence_capable": {"type": "boolean"}
        }
      }
    }
  }
}
