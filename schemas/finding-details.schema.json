{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:finding-details:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing_snapshot_id", "review_state_digest", "registry_sha256", "source_digest", "compilation_input_digest", "findings"],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_state": {"enum": ["TEMPLATE", "COMPLETED"]},
    "routing_snapshot_id": {"$ref": "#/$defs/hash"},
    "review_state_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "registry_sha256": {"$ref": "#/$defs/hash"},
    "source_digest": {"$ref": "#/$defs/hash"},
    "compilation_input_digest": {"$ref": "#/$defs/hash"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "location", "description", "recommendation"],
        "properties": {
          "canonical_id": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
