{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:issue-candidates:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing_snapshot_id", "registry_sha256", "source_digest", "compilation_input_digest", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "routing_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compilation_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "severity"],
        "properties": {
          "canonical_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["Medium", "High", "Critical"]}
        }
      }
    }
  }
}
