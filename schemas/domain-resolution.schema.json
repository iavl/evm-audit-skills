{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:domain-resolution:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing_snapshot_id", "registry_sha256", "source_digest", "compilation_input_digest", "domains"],
  "properties": {
    "schema_version": {"const": 2},
    "routing_snapshot_id": {"$ref": "#/$defs/hash"},
    "registry_sha256": {"$ref": "#/$defs/hash"},
    "source_digest": {"$ref": "#/$defs/hash"},
    "compilation_input_digest": {"$ref": "#/$defs/hash"},
    "domains": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/resolution"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "reason"],
      "properties": {
        "kind": {"enum": ["scope", "source", "inheritance", "interface", "dependency", "deployment", "environment", "compiler-ast", "test", "trace", "calculation", "invariant", "manual"]},
        "location": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope_complete", "evidence"],
      "properties": {
        "status": {"enum": ["PRESENT", "ABSENT_CONFIRMED", "UNKNOWN"]},
        "scope_complete": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["PRESENT", "ABSENT_CONFIRMED"]}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "ABSENT_CONFIRMED"}}},
          "then": {"properties": {"scope_complete": {"const": true}}}
        }
      ]
    }
  }
}
