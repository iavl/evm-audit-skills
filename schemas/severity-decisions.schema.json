{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:severity-decisions:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing_snapshot_id", "review_state_digest", "registry_sha256", "source_digest", "compilation_input_digest", "decisions"],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_state": {"enum": ["TEMPLATE", "COMPLETED"]},
    "routing_snapshot_id": {"$ref": "#/$defs/hash"},
    "review_state_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "registry_sha256": {"$ref": "#/$defs/hash"},
    "source_digest": {"$ref": "#/$defs/hash"},
    "compilation_input_digest": {"$ref": "#/$defs/hash"},
    "decisions": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "rationale", "dimensions"],
      "properties": {
        "severity": {"enum": ["Info", "Low", "Medium", "High", "Critical"]},
        "rationale": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["impact", "exploitability", "privileges", "capital_required", "repeatability", "user_interaction", "loss_bound", "protocol_exposure", "recoverability"],
          "properties": {
            "impact": {"enum": ["none", "limited_user_loss", "fund_loss", "data_integrity", "denial_of_service", "governance_control", "infrastructure_compromise"]},
            "exploitability": {"enum": ["permissionless", "ordinary_user", "operator_only", "admin_only", "governance_only", "environment_dependent"]},
            "privileges": {"enum": ["none", "ordinary_user", "operator", "admin", "governance"]},
            "capital_required": {"enum": ["none", "low", "medium", "high", "protocol_liquidity"]},
            "repeatability": {"enum": ["one_shot", "repeatable", "state_consuming"]},
            "user_interaction": {"enum": ["none", "attacker_only", "victim_action", "operator_action"]},
            "loss_bound": {"enum": ["none", "single_user", "affected_users", "protocol_liquidity", "unbounded"]},
            "protocol_exposure": {"enum": ["single_position", "affected_users", "whole_protocol", "ecosystem"]},
            "recoverability": {"enum": ["irreversible", "user_recoverable", "admin_remediable", "governance_remediable"]}
          }
        }
      }
    }
  }
}
