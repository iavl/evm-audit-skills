{
  "id": "evm-audit-defi-amm",
  "name": "AMM and DEX Security",
  "checklist_title": "AMM & DEX Security Checklist",
  "description": "Security review for AMMs, DEXs, swap routers, liquidity pools, and hooks.",
  "surface_features": [
    "uses-amm"
  ],
  "related_domains": [
    "evm-audit-precision-math",
    "evm-audit-erc20",
    "evm-audit-oracles"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "pool_model",
      "required": true,
      "description": "pool and invariant model"
    },
    {
      "key": "fee_model",
      "required": true,
      "description": "fee tiers and fee accounting"
    },
    {
      "key": "liquidity_model",
      "required": true,
      "description": "liquidity sources, depth, and price impact"
    },
    {
      "key": "hook_surface",
      "required": true,
      "description": "hooks, callbacks, and external control points"
    },
    {
      "key": "price_source",
      "required": true,
      "description": "spot, TWAP, oracle, or other price source"
    }
  ],
  "review_requirements": [
    "model price impact, slippage, callback, and accounting invariants"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
