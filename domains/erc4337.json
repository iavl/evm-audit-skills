{
  "id": "evm-audit-erc4337",
  "name": "ERC4337 Account Abstraction Security",
  "checklist_title": "ERC4337 Account Abstraction Security Checklist",
  "description": "Security review for ERC4337 wallets, paymasters, bundlers, and account-abstraction infrastructure.",
  "surface_features": [
    "uses-erc4337"
  ],
  "related_domains": [
    "evm-audit-signatures",
    "evm-audit-access-control"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "entrypoint_version",
      "required": true,
      "description": "EntryPoint implementation and version"
    },
    {
      "key": "account_modules",
      "required": true,
      "description": "account, validation, and module execution surface"
    },
    {
      "key": "paymaster_model",
      "required": true,
      "description": "paymaster validation, sponsorship, and settlement"
    },
    {
      "key": "bundler_assumptions",
      "required": true,
      "description": "bundler, simulation, and mempool assumptions"
    }
  ],
  "review_requirements": [
    "trace validation, replay, prefund, and execution boundaries"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
