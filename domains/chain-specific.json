{
  "id": "evm-audit-chain-specific",
  "name": "Chain-Specific Security",
  "checklist_title": "Chain-Specific Security Checklist",
  "description": "Security review for non-mainnet EVM deployments and chain-specific execution assumptions.",
  "surface_features": [
    "uses-chain-specific"
  ],
  "related_domains": [
    "evm-audit-oracles",
    "evm-audit-assembly"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "chain_family",
      "required": true,
      "description": "target chain family and network"
    },
    {
      "key": "execution_environment",
      "required": true,
      "description": "EVM, EraVM, interpreter, or other execution environment"
    },
    {
      "key": "evm_fork",
      "required": true,
      "description": "active EVM fork and opcode semantics"
    },
    {
      "key": "deployed_bytecode",
      "required": true,
      "description": "deployed bytecode and system-contract assumptions"
    }
  ],
  "review_requirements": [
    "verify every relied-upon opcode and system-contract behavior"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
