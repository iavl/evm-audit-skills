{
  "id": "evm-audit-bridges",
  "name": "Bridge and Cross-Chain Security",
  "checklist_title": "Bridge & Cross-Chain Security Checklist",
  "description": "Security review for cross-chain bridges, messaging, relayers, and adapters.",
  "surface_features": [
    "uses-bridge"
  ],
  "related_domains": [
    "evm-audit-signatures",
    "evm-audit-chain-specific"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "source_chain",
      "required": true,
      "description": "source chain and message origin"
    },
    {
      "key": "destination_chain",
      "required": true,
      "description": "destination chain and message execution target"
    },
    {
      "key": "finality_model",
      "required": true,
      "description": "finality, confirmations, and reorg assumptions"
    },
    {
      "key": "message_authentication",
      "required": true,
      "description": "message validation and authentication path"
    },
    {
      "key": "relayer_model",
      "required": true,
      "description": "relayer, quorum, and delivery assumptions"
    }
  ],
  "review_requirements": [
    "model message lifecycle, replay, ordering, and failure recovery"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
