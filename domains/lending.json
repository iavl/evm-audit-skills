{
  "id": "evm-audit-defi-lending",
  "name": "Lending and Liquidation Security",
  "checklist_title": "Lending & Liquidation Security Checklist",
  "description": "Security review for lending, borrowing, collateral, liquidation, and CDP protocols.",
  "surface_features": [
    "uses-lending"
  ],
  "related_domains": [
    "evm-audit-precision-math",
    "evm-audit-erc20",
    "evm-audit-oracles"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "oracle_configuration",
      "required": true,
      "description": "price sources, freshness, and oracle configuration"
    },
    {
      "key": "collateral_parameters",
      "required": true,
      "description": "collateral factors, LTV, and liquidation thresholds"
    },
    {
      "key": "market_caps",
      "required": true,
      "description": "supply, borrow, and liquidity caps"
    },
    {
      "key": "liquidation_model",
      "required": true,
      "description": "liquidation, auction, and bad-debt handling"
    },
    {
      "key": "interest_model",
      "required": true,
      "description": "interest accrual and reserve accounting"
    }
  ],
  "review_requirements": [
    "model solvency, bad debt, and liquidation economics"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
