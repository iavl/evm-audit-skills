{
  "id": "evm-audit-governance",
  "name": "Governance and DAO Security",
  "checklist_title": "Governance & DAO Security Checklist",
  "description": "Security review for governance, voting, proposals, timelocks, and treasury control.",
  "surface_features": [
    "uses-governance"
  ],
  "related_domains": [
    "evm-audit-access-control",
    "evm-audit-flashloans"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "voting_power",
      "required": true,
      "description": "voting power, delegation, and snapshot model"
    },
    {
      "key": "quorum_model",
      "required": true,
      "description": "quorum and participation calculation"
    },
    {
      "key": "timelock",
      "required": true,
      "description": "timelock delay, cancellation, and execution authority"
    },
    {
      "key": "proposal_model",
      "required": true,
      "description": "proposal lifecycle and validation"
    },
    {
      "key": "execution_model",
      "required": true,
      "description": "proposal execution order and target-call surface"
    }
  ],
  "review_requirements": [
    "trace proposal creation through execution and cancellation"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
