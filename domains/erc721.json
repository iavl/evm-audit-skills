{
  "id": "evm-audit-erc721",
  "name": "ERC721 and ERC1155 Security",
  "checklist_title": "ERC721/ERC1155 Security Checklist",
  "description": "Security review for ERC721, ERC1155, NFT implementations, and NFT integrations.",
  "surface_features": [
    "uses-erc721"
  ],
  "related_domains": [
    "evm-audit-general",
    "evm-audit-access-control"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "accepted_nft_standards",
      "required": true,
      "description": "accepted ERC721/ERC1155 standards and token assumptions"
    },
    {
      "key": "receiver_hooks",
      "required": true,
      "description": "receiver callbacks and hook behavior"
    },
    {
      "key": "approval_model",
      "required": true,
      "description": "approval, operator, and transfer authorization model"
    },
    {
      "key": "custody_model",
      "required": true,
      "description": "custody, ownership, and escrow model"
    }
  ],
  "review_requirements": [
    "trace ownership, callback, and transfer compatibility"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
