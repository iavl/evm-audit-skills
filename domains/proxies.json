{
  "id": "evm-audit-proxies",
  "name": "Proxy and Upgrade Security",
  "checklist_title": "Proxy & Upgrade Security Checklist",
  "description": "Security review for proxies, upgrade mechanisms, initializers, and storage layouts.",
  "surface_features": [
    "uses-proxy"
  ],
  "related_domains": [
    "evm-audit-access-control",
    "evm-audit-assembly"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "proxy_kind",
      "required": true,
      "description": "proxy pattern and deployment topology"
    },
    {
      "key": "implementation",
      "required": true,
      "description": "implementation address and code identity"
    },
    {
      "key": "admin",
      "required": true,
      "description": "upgrade administrator or governance authority"
    },
    {
      "key": "initializer",
      "required": true,
      "description": "initializer and initialization state"
    },
    {
      "key": "upgrade_path",
      "required": true,
      "description": "upgrade authorization, storage, and migration path"
    }
  ],
  "review_requirements": [
    "trace initialization, authorization, and storage compatibility"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
