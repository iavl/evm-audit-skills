{
  "id": "evm-audit-erc20",
  "name": "ERC20 Integration Security",
  "checklist_title": "Weird ERC20 Security Checklist",
  "description": "Security review for contracts that implement or integrate ERC20-compatible tokens.",
  "surface_features": [
    "uses-erc20"
  ],
  "related_domains": [
    "evm-audit-general",
    "evm-audit-precision-math"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "accepted_tokens",
      "required": true,
      "description": "accepted token contracts and non-standard token assumptions"
    },
    {
      "key": "balance_accounting",
      "required": true,
      "description": "balance, supply, and fee accounting"
    },
    {
      "key": "allowances",
      "required": true,
      "description": "allowance and approval behavior"
    },
    {
      "key": "transfer_wrappers",
      "required": true,
      "description": "transfer and safe-wrapper behavior"
    }
  ],
  "review_requirements": [
    "test non-standard token behaviors against accounting invariants"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
