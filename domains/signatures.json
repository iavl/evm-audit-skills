{
  "id": "evm-audit-signatures",
  "name": "Signature Security",
  "checklist_title": "Signature Security Checklist",
  "description": "Security review for signatures, permits, EIP-712, and meta-transactions.",
  "surface_features": [
    "uses-signature"
  ],
  "related_domains": [
    "evm-audit-access-control",
    "evm-audit-chain-specific"
  ],
  "always_screen": false,
  "required_context": [
    {
      "key": "signed_payload",
      "required": true,
      "description": "signed fields and canonical encoding"
    },
    {
      "key": "domain_separator",
      "required": true,
      "description": "EIP-712 domain and version binding"
    },
    {
      "key": "nonce",
      "required": true,
      "description": "nonce, replay, and invalidation model"
    },
    {
      "key": "signer",
      "required": true,
      "description": "signer recovery and authorization mapping"
    },
    {
      "key": "chain_binding",
      "required": true,
      "description": "chain, contract, and fork binding"
    }
  ],
  "review_requirements": [
    "test replay, malleability, expiry, and signer ambiguity"
  ],
  "trusted_absence_policy": {"requires_complete_scope": true, "allowed_evidence": ["scope", "inheritance", "interface", "dependency", "deployment"]}
}
